[Unit]
Description=corthexis — reindex as soon as a note changes (complements the timer)

[Path]
# inotify on the notes folder -> triggers corthexis-index.service on every write,
# add or delete. The reindex is incremental, so this costs a few seconds.
PathModified=%h/notes
TriggerLimitIntervalSec=20s

[Install]
WantedBy=paths.target
