# CortHeXis — configuration of the Docker install. ./setup.sh writes .env from this file.
# Every variable is optional except CORTHEXIS_TOKEN.

# --- access --------------------------------------------------------------------------
# Guards MCP (/mcp), the recall hook endpoint and every write. 32+ characters.
CORTHEXIS_TOKEN=
# Where the dashboard listens on the host (loopback by default; put a proxy in front to share it)
CORTHEXIS_BIND=127.0.0.1
CORTHEXIS_PORT=8420
CORTHEXIS_PUBLIC_URL=http://localhost:8420
# 1 = anyone who reaches the port may READ the dashboard (writes still need the token)
CORTHEXIS_DASHBOARD_PUBLIC=0
# en | fr (default: the browser's language)
CORTHEXIS_UI_LANG=

# --- the notes ---------------------------------------------------------------------
# The folder of markdown notes (one fact per file). Claude Code keeps its memory in
# ~/.claude/projects/<project-slug>/memory
CORTHEXIS_NOTES=./examples/agent-memory
# The container runs as the owner of that folder (it may rename files to the naming
# convention, write MEMORY.md and apply the repairs you approve)
CORTHEXIS_UID=1000
CORTHEXIS_GID=1000
# false = never rename or rewrite a note (the review still reports what is off)
CORTHEXIS_NORMALIZE=true
# false = do not write the MEMORY.md index
CORTHEXIS_WRITE_INDEX=true

# --- models ------------------------------------------------------------------------
# leger (CPU, default) | standard (CPU + background reranker) | gpu (see the README)
CORTHEXIS_MEMORY_PROFILE=leger
# Gemma Terms of Use for the default embedding model: 1 = accept, 0 = decline (MIT model
# multilingual-e5-base instead); empty = undecided → the MIT model runs until you decide.
# ./setup.sh asks the question and records the answer in the models volume.
CORTHEXIS_ACCEPT_GEMMA_TERMS=
# Who accepted (recorded with the decision)
CORTHEXIS_OWNER=
# Mirror for the model downloads (default https://huggingface.co)
CORTHEXIS_MODEL_BASE_URL=

# --- review and notifications --------------------------------------------------------
CORTHEXIS_REVIEW_EVERY_S=3600
CORTHEXIS_REVIEW_DIGEST_AT=08:20
CORTHEXIS_REVIEW_TZ=UTC
# Webhooks (comma-separated); prefix a URL with slack+ discord+ ntfy+ mattermost+ teams+
# to pick the payload, default JSON {"title","text","link","kind"}
CORTHEXIS_NOTIFY_WEBHOOKS=
CORTHEXIS_NOTIFY_FORMAT=json
# Or a shell command fed the message on stdin
CORTHEXIS_NOTIFY_CMD=

# --- database ----------------------------------------------------------------------
CORTHEXIS_DB_PASSWORD=corthexis
